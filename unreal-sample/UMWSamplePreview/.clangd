# UE 5.8 的 compile_commands.json 由 UBT 生成：
#   D:/UE_5.8/Engine/Build/BatchFiles/Build.bat UnrealEditor Win64 Development \
#     -project=<本工程 .uproject> -Mode=GenerateClangDatabase
# 生成后本工程及其插件源码即可被 clangd 正确索引；该文件不入库（见根 .gitignore）。
CompileFlags:
  # 相对 .clangd 所在目录解析，指向 UBT 生成的编译数据库。
  CompilationDatabase: .
  # UE 的 UE_LOG 宏在 clangd 内置的 clang 23 下，每个调用点都会报一次
  # invalid-token-paste（真实编译用的 clang-cl 19 不报）。这类诊断会吃满 clang
  # 默认 20 条的错误上限，一旦超限它就中断解析，随后冒出一大串"X 不是 Y 的派生"
  # 的连锁假错误。下面放开错误上限，配合 Diagnostics 里抑制该诊断一起解决。
  Add: [-ferror-limit=0]
  Remove:
    # clangd 无法实现 MSVC 的 PCH/调试与增量链接选项，保留会产生噪音诊断。
    - -Z7
    - -Zi
    - -ZI
    - -Gm
    - -Gv
    - -Gy
    - -Gw
    - -Brepro
    - /Brepro
    - -fms-hotpatch
    - -fno-temp-file
    - -fwritable-strings
    # 引擎编译把告警当错误；索引阶段不需要，否则头文件噪声会淹没结果。
    - -Werror
    - -Wshadow
    # 并行编译对索引没有意义（clangd 的 Remove 按前缀匹配，/MP 无 MSVC 语义冲突）。
    - -MP
    # 注意：这里绝不能放 -MD / -MT。clangd 做前缀匹配时会连带命中 MSVC 的
    # /MD、/MT（C 运行库选择）：移除 /MD 后 clangd 按静态 CRT 解析，缺 _DLL
    # 宏，STL/UE 头会走错分支，然后报一串"类型不匹配"的假错误
    # （例如 cannot initialize return object of type 'UObject*'）。
    - -fdeprecated-macro
Diagnostics:
  # 引擎第三方头、生成代码与内建函数噪声较多，抑制非本工程诊断。
  Suppress:
    - 'builtin_definition'
    - 'drv_unknown_argument'
    # clangd 内置的 clang 23 与 UE 5.8 的 UE_PRIVATE_APPEND_VA_ARG_COUNT 宏有兼容性
    # 差异（真实编译用的 clang-cl 19 不报），属工具链版本噪音，不是代码问题。
    - 'invalid-token-paste'
  UnusedIncludes: None
Index:
  Background: Build
